generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
}

enum PredictionType {
  FRAUD_DETECTION
  ANOMALY_DETECTION
  RISK_ASSESSMENT
}

model Invoice {
  id                         String        @id @default(uuid()) @db.Uuid
  businessId                 String        @db.Uuid
  clientId                   String        @db.Uuid
  createdBy                  String?       @db.Uuid
  invoiceNumber              String
  status                     InvoiceStatus
  issueDate                  DateTime
  dueDate                    DateTime
  totalAmount                Float
  taxAmount                  Float
  pdfUrl                     String
  notes                      String
  lastReminderSentAt         DateTime?
  nextReminderDueAt          DateTime?
  reminderCount              Int           @default(0)
  reminderProcessingStartedAt DateTime?
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
  deletedAt                  DateTime?

  items    InvoiceItem[]
  payments Payment[]

  @@index([businessId])
  @@index([createdBy])
  @@index([invoiceNumber])
  @@index([status, dueDate])
  @@index([nextReminderDueAt])
  @@index([reminderProcessingStartedAt])
}

model InvoiceItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @db.Uuid
  description String
  quantity    Int
  unitPrice   Float
  amount      Float
  createdAt   DateTime @default(now())
  deletedAt   DateTime?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  invoiceId   String        @db.Uuid
  amount      Float
  paymentDate DateTime
  method      PaymentMethod
  reference   String
  createdAt   DateTime @default(now())
  deletedAt   DateTime?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model AIPrediction {
  id              String            @id @default(uuid()) @db.Uuid
  businessId      String            @db.Uuid
  invoiceId       String?           @db.Uuid
  expenseId       String?           @db.Uuid
  type            PredictionType
  prediction      Json              // Full prediction JSON (fraud, confidence, etc)
  confidence      Float             // 0-1 confidence score
  riskLevel       String?           // low, medium, high
  isFlagged       Boolean           @default(false)
  actionTaken     String?           // Description of action (if any)
  metadata        Json?             // Additional data
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  @@index([businessId])
  @@index([invoiceId])
  @@index([expenseId])
  @@index([type])
  @@index([isFlagged])
  @@index([createdAt])
}
